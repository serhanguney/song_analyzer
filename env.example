CLIENT_SECRET=your_secret_key_here
CLIENT_ID=your_id_here

# Directory containing music files to process (for metadata updater)
MUSIC_DIRECTORY=./music

# Source directory containing new songs to organize (for organizer)
SOURCE_DIRECTORY=./new_songs

# Target directory where organized songs will be moved to (for organizer)
TARGET_DIRECTORY=./organized_music

# Directory containing songs for manual tag updates (for update-tag script)
PREPARATION_DIRECTORY=./preparation

# Spotify OAuth redirect URI (for add-to-playlist script)
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# Spotify playlist ID to add songs to (for add-to-playlist script)
PLAYLIST_ID=

